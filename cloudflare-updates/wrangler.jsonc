{
  "name": "clawd-updates",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "clawd-updates.chronokalamos.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
